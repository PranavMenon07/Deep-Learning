      "source": [
        "\"\"\"\n",
        "CS3807 - Deep Learning Laboratory\n",
        "Experiment 1: Single Layer Perceptron for Binary Classification\n",
        "Dataset: Banknote Authentication (UCI)\n",
        "\n",
        "This script is a REFERENCE implementation covering Tasks 1-6 and the\n",
        "mandatory plots. Read every section, understand it, then rewrite it in\n",
        "your own style/variable names for your submission. Do not submit this\n",
        "verbatim - the course requires original work.\n",
        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import (accuracy_score, precision_score, recall_score,\n",
        "                              f1_score, confusion_matrix, ConfusionMatrixDisplay)\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "np.random.seed(RANDOM_STATE)\n",
        "\n",
        "# All figures are saved at 600 DPI (publication/report quality)\n",
        "DPI = 600\n",
        "plt.rcParams[\"savefig.dpi\"] = DPI\n",
        "plt.rcParams[\"figure.dpi\"] = 100  # keep on-screen rendering fast; only saved files use 600\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# TASK 1: Dataset Exploration\n",
        "# ---------------------------------------------------------------------\n",
        "# Download data_banknote_authentication.txt from:\n",
        "# https://archive.ics.uci.edu/dataset/267/banknote+authentication\n",
        "# Place it in the same folder as this script, or point to its path below.\n",
        "\n",
        "COLUMNS = [\"variance\", \"skewness\", \"curtosis\", \"entropy\", \"class\"]\n",
        "DATA_PATH = \"data_banknote_authentication.txt\"\n",
        "\n",
        "df = pd.read_csv(DATA_PATH, header=None, names=COLUMNS)\n",
        "\n",
        "print(\"First 5 samples:\\n\", df.head())\n",
        "print(\"\\nShape:\", df.shape)\n",
        "print(\"\\nMissing values:\\n\", df.isnull().sum())\n",
        "print(\"\\nDescriptive statistics:\\n\", df.describe())\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# TASK 2: Exploratory Data Analysis\n",
        "# ---------------------------------------------------------------------\n",
        "os_makedirs = \"plots\"\n",
        "import os\n",
        "os.makedirs(os_makedirs, exist_ok=True)\n",
        "\n",
        "# Histograms\n",
        "df.drop(columns=[\"class\"]).hist(bins=30, figsize=(10, 8))\n",
        "plt.suptitle(\"Feature Histograms\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/histograms.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# Correlation heatmap\n",
        "plt.figure(figsize=(6, 5))\n",
        "sns.heatmap(df.corr(), annot=True, cmap=\"coolwarm\")\n",
        "plt.title(\"Correlation Heatmap\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/correlation_heatmap.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# Scatter plot (two most informative-looking features)\n",
        "plt.figure(figsize=(6, 5))\n",
        "sns.scatterplot(data=df, x=\"variance\", y=\"skewness\", hue=\"class\", palette=\"Set1\")\n",
        "plt.title(\"Scatter Plot: Variance vs Skewness\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/scatter_plot.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# Boxplots\n",
        "plt.figure(figsize=(10, 6))\n",
        "df.drop(columns=[\"class\"]).boxplot()\n",
        "plt.title(\"Boxplots of Features\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/boxplots.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Combined EDA Figure: histograms + heatmap + scatter + boxplot in one grid\n",
        "# ---------------------------------------------------------------------\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 11))\n",
        "\n",
        "# (0,0) Histograms of all 4 features overlaid\n",
        "for col in [\"variance\", \"skewness\", \"curtosis\", \"entropy\"]:\n",
        "    axes[0, 0].hist(df[col], bins=30, alpha=0.5, label=col)\n",
        "axes[0, 0].set_title(\"Feature Histograms\")\n",
        "axes[0, 0].set_xlabel(\"Value\")\n",
        "axes[0, 0].set_ylabel(\"Frequency\")\n",
        "axes[0, 0].legend(fontsize=8)\n",
        "\n",
        "# (0,1) Correlation heatmap\n",
        "sns.heatmap(df.corr(), annot=True, cmap=\"coolwarm\", ax=axes[0, 1], cbar=True)\n",
        "axes[0, 1].set_title(\"Correlation Heatmap\")\n",
        "\n",
        "# (1,0) Scatter plot\n",
        "sns.scatterplot(data=df, x=\"variance\", y=\"skewness\", hue=\"class\",\n",
        "                 palette=\"Set1\", ax=axes[1, 0])\n",
        "axes[1, 0].set_title(\"Scatter Plot: Variance vs Skewness\")\n",
        "\n",
        "# (1,1) Boxplots\n",
        "df.drop(columns=[\"class\"]).boxplot(ax=axes[1, 1])\n",
        "axes[1, 1].set_title(\"Boxplots of Features\")\n",
        "\n",
        "fig.suptitle(\"Combined Exploratory Data Analysis\", fontsize=16, fontweight=\"bold\")\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
        "plt.savefig(f\"{os_makedirs}/combined_eda.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# TASK 3: Data Preprocessing\n",
        "# ---------------------------------------------------------------------\n",
        "X = df.drop(columns=[\"class\"]).values\n",
        "y = df[\"class\"].values\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_scaled, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# TASK 4 & 5: Perceptron Implementation and Training\n",
        "# ---------------------------------------------------------------------\n",
        "class SingleLayerPerceptron:\n",
        "    def __init__(self, n_features, learning_rate=0.01, n_epochs=50):\n",
        "        self.lr = learning_rate\n",
        "        self.n_epochs = n_epochs\n",
        "        self.weights = np.zeros(n_features)\n",
        "        self.bias = 0.0\n",
        "        self.history = {\"epoch\": [], \"errors\": [], \"weights\": [], \"bias\": []}\n",
        "\n",
        "    @staticmethod\n",
        "    def step_activation(z):\n",
        "        return np.where(z >= 0, 1, 0)\n",
        "\n",
        "    def predict(self, X):\n",
        "        z = np.dot(X, self.weights) + self.bias\n",
        "        return self.step_activation(z)\n",
        "\n",
        "    def fit(self, X, y, verbose=True):\n",
        "        for epoch in range(1, self.n_epochs + 1):\n",
        "            errors = 0\n",
        "            for xi, target in zip(X, y):\n",
        "                z = np.dot(xi, self.weights) + self.bias\n",
        "                y_hat = self.step_activation(z)\n",
        "                update = self.lr * (target - y_hat)\n",
        "                if update != 0.0:\n",
        "                    self.weights += update * xi\n",
        "                    self.bias += update\n",
        "                    errors += 1\n",
        "\n",
        "            self.history[\"epoch\"].append(epoch)\n",
        "            self.history[\"errors\"].append(errors)\n",
        "            self.history[\"weights\"].append(self.weights.copy())\n",
        "            self.history[\"bias\"].append(self.bias)\n",
        "\n",
        "            if verbose:\n",
        "                print(f\"Epoch {epoch:3d} | Misclassified: {errors:4d} | \"\n",
        "                      f\"Weights: {np.round(self.weights, 4)} | Bias: {self.bias:.4f}\")\n",
        "\n",
        "            if errors == 0:\n",
        "                print(f\"Converged at epoch {epoch}.\")\n",
        "                break\n",
        "        return self\n",
        "\n",
        "\n",
        "model = SingleLayerPerceptron(n_features=X_train.shape[1], learning_rate=0.01, n_epochs=50)\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# TASK 6: Model Evaluation\n",
        "# ---------------------------------------------------------------------\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "prec = precision_score(y_test, y_pred)\n",
        "rec = recall_score(y_test, y_pred)\n",
        "f1 = f1_score(y_test, y_pred)\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "print(\"\\n--- Test Set Performance ---\")\n",
        "print(f\"Accuracy : {acc:.4f}\")\n",
        "print(f\"Precision: {prec:.4f}\")\n",
        "print(f\"Recall   : {rec:.4f}\")\n",
        "print(f\"F1-score : {f1:.4f}\")\n",
        "print(\"Confusion Matrix:\\n\", cm)\n",
        "\n",
        "ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"Authentic\", \"Forged\"]).plot(cmap=\"Blues\")\n",
        "plt.title(\"Confusion Matrix\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/confusion_matrix.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Mandatory Plots: Training Error vs Epoch, Weight Evolution, Bias Evolution\n",
        "# ---------------------------------------------------------------------\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.plot(model.history[\"epoch\"], model.history[\"errors\"], marker=\"o\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Misclassified Samples\")\n",
        "plt.title(\"Training Error vs Epoch\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/error_vs_epoch.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "weights_arr = np.array(model.history[\"weights\"])\n",
        "plt.figure(figsize=(6, 4))\n",
        "for i in range(weights_arr.shape[1]):\n",
        "    plt.plot(model.history[\"epoch\"], weights_arr[:, i], label=f\"w{i+1}\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Weight Value\")\n",
        "plt.title(\"Weight Evolution\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/weight_evolution.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.plot(model.history[\"epoch\"], model.history[\"bias\"], color=\"orange\", marker=\"o\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Bias Value\")\n",
        "plt.title(\"Bias Evolution\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/bias_evolution.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Combined Training Dynamics Figure: error, weights, bias in one row\n",
        "# ---------------------------------------------------------------------\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "\n",
        "axes[0].plot(model.history[\"epoch\"], model.history[\"errors\"], marker=\"o\", color=\"tab:blue\")\n",
        "axes[0].set_xlabel(\"Epoch\")\n",
        "axes[0].set_ylabel(\"Misclassified Samples\")\n",
        "axes[0].set_title(\"Training Error vs Epoch\")\n",
        "\n",
        "for i in range(weights_arr.shape[1]):\n",
        "    axes[1].plot(model.history[\"epoch\"], weights_arr[:, i], label=f\"w{i+1}\")\n",
        "axes[1].set_xlabel(\"Epoch\")\n",
        "axes[1].set_ylabel(\"Weight Value\")\n",
        "axes[1].set_title(\"Weight Evolution\")\n",
        "axes[1].legend(fontsize=8)\n",
        "\n",
        "axes[2].plot(model.history[\"epoch\"], model.history[\"bias\"], marker=\"o\", color=\"tab:orange\")\n",
        "axes[2].set_xlabel(\"Epoch\")\n",
        "axes[2].set_ylabel(\"Bias Value\")\n",
        "axes[2].set_title(\"Bias Evolution\")\n",
        "\n",
        "fig.suptitle(\"Combined Training Dynamics\", fontsize=16, fontweight=\"bold\")\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.94])\n",
        "plt.savefig(f\"{os_makedirs}/combined_training_dynamics.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Task 7 (Additional Task 3): Learning Rate Comparison\n",
        "# ---------------------------------------------------------------------\n",
        "learning_rates = [0.001, 0.01, 0.1]\n",
        "plt.figure(figsize=(7, 5))\n",
        "for lr in learning_rates:\n",
        "    m = SingleLayerPerceptron(n_features=X_train.shape[1], learning_rate=lr, n_epochs=50)\n",
        "    m.fit(X_train, y_train, verbose=False)\n",
        "    plt.plot(m.history[\"epoch\"], m.history[\"errors\"], label=f\"lr={lr}\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Misclassified Samples\")\n",
        "plt.title(\"Learning Rate Comparison\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/learning_rate_comparison.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Combined Evaluation Figure: confusion matrix + learning rate comparison\n",
        "# ---------------------------------------------------------------------\n",
        "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
        "\n",
        "ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"Authentic\", \"Forged\"]).plot(\n",
        "    cmap=\"Blues\", ax=axes[0], colorbar=False\n",
        ")\n",
        "axes[0].set_title(\"Confusion Matrix\")\n",
        "\n",
        "for lr in learning_rates:\n",
        "    m = SingleLayerPerceptron(n_features=X_train.shape[1], learning_rate=lr, n_epochs=50)\n",
        "    m.fit(X_train, y_train, verbose=False)\n",
        "    axes[1].plot(m.history[\"epoch\"], m.history[\"errors\"], label=f\"lr={lr}\")\n",
        "axes[1].set_xlabel(\"Epoch\")\n",
        "axes[1].set_ylabel(\"Misclassified Samples\")\n",
        "axes[1].set_title(\"Learning Rate Comparison\")\n",
        "axes[1].legend()\n",
        "\n",
        "fig.suptitle(\"Model Evaluation Summary\", fontsize=16, fontweight=\"bold\")\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.94])\n",
        "plt.savefig(f\"{os_makedirs}/combined_evaluation.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Optional: Decision Boundary using two features (variance, skewness)\n",
        "# ---------------------------------------------------------------------\n",
        "X2 = X_scaled[:, :2]\n",
        "X2_train, X2_test, y2_train, y2_test = train_test_split(\n",
        "    X2, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
        ")\n",
        "m2 = SingleLayerPerceptron(n_features=2, learning_rate=0.01, n_epochs=50)\n",
        "m2.fit(X2_train, y2_train, verbose=False)\n",
        "\n",
        "x_min, x_max = X2[:, 0].min() - 1, X2[:, 0].max() + 1\n",
        "y_min, y_max = X2[:, 1].min() - 1, X2[:, 1].max() + 1\n",
        "xx, yy = np.meshgrid(np.linspace(x_min, x_max, 300), np.linspace(y_min, y_max, 300))\n",
        "grid_pred = m2.predict(np.c_[xx.ravel(), yy.ravel()]).reshape(xx.shape)\n",
        "\n",
        "plt.figure(figsize=(6, 5))\n",
        "plt.contourf(xx, yy, grid_pred, alpha=0.3, cmap=\"coolwarm\")\n",
        "plt.scatter(X2[:, 0], X2[:, 1], c=y, cmap=\"coolwarm\", edgecolor=\"k\", s=15)\n",
        "plt.xlabel(\"Variance (scaled)\")\n",
        "plt.ylabel(\"Skewness (scaled)\")\n",
        "plt.title(\"Decision Boundary (Variance vs Skewness)\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{os_makedirs}/decision_boundary.png\", dpi=DPI, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Additional Task 2: Compare with Scikit-learn's Perceptron\n",
        "# ---------------------------------------------------------------------\n",
        "from sklearn.linear_model import Perceptron as SKPerceptron\n",
        "\n",
        "sk_model = SKPerceptron(max_iter=50, eta0=0.01, random_state=RANDOM_STATE)\n",
        "sk_model.fit(X_train, y_train)\n",
        "sk_pred = sk_model.predict(X_test)\n",
        "print(\"\\n--- Scikit-learn Perceptron ---\")\n",
        "print(\"Accuracy:\", accuracy_score(y_test, sk_pred))\n",
        "\n",
        "print(f\"\\nAll plots saved to the '{os_makedirs}/' directory at {DPI} DPI.\")\n",
        "print(\"Combined figures: combined_eda.png, combined_training_dynamics.png, combined_evaluation.png\")"
