        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import (accuracy_score, precision_score, recall_score,\n",
        "                              f1_score, confusion_matrix, ConfusionMatrixDisplay)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Setup\n",
        "# ---------------------------------------------------------------------\n",
        "RANDOM_STATE = 42\n",
        "np.random.seed(RANDOM_STATE)\n",
        "\n",
        "DPI = 150  # report-quality, not print/press quality - keeps files small\n",
        "plt.rcParams[\"savefig.dpi\"] = DPI\n",
        "plt.rcParams[\"figure.dpi\"] = 100\n",
        "PNG_KWARGS = dict(dpi=DPI, bbox_inches=\"tight\", pil_kwargs={\"compress_level\": 9})\n",
        "\n",
        "PLOTS_DIR = \"plots\"\n",
        "os.makedirs(PLOTS_DIR, exist_ok=True)\n",
        "\n",
        "COLUMNS = [\"variance\", \"skewness\", \"curtosis\", \"entropy\", \"class\"]\n",
        "DATA_PATH = \"data_banknote_authentication.txt\"\n",
        "\n",
        "df = pd.read_csv(DATA_PATH, header=None, names=COLUMNS)\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 1: Feature Histograms\n",
        "# ---------------------------------------------------------------------\n",
        "df.drop(columns=[\"class\"]).hist(bins=30, figsize=(7, 5.5))\n",
        "plt.suptitle(\"Figure 1: Feature Histograms\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/histograms.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 2: Correlation Heatmap\n",
        "# ---------------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(4.5, 3.8))\n",
