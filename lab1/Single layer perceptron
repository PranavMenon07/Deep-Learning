        "    model.fit(X_train, y_train)\n",
        "    ax.plot(model.history[\"epoch\"], model.history[\"errors\"], marker=\"o\", markersize=3, label=f\"lr={lr}\")\n",
        "\n",
        "ax.set_xlabel(\"Epoch\")\n",
