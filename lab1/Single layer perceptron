        "ax.set_title(\"Figure 2: Correlation Heatmap\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/correlation_heatmap.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 3: Scatter Plot\n",
        "# ---------------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(4.5, 3.8))\n",
        "sns.scatterplot(data=df, x=\"variance\", y=\"skewness\", hue=\"class\", palette=\"Set1\", ax=ax)\n",
        "ax.set_title(\"Figure 3: Scatter Plot (Variance vs Skewness)\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/scatter_plot.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 4: Boxplots of Features\n",
        "# ---------------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(7, 4.2))\n",
        "df.drop(columns=[\"class\"]).boxplot(ax=ax)\n",
        "ax.set_title(\"Figure 4: Boxplots of Features\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/boxplots.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Preprocessing (needed before training)\n",
        "# ---------------------------------------------------------------------\n",
        "X = df.drop(columns=[\"class\"]).values\n",
        "y = df[\"class\"].values\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_scaled, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Perceptron implementation (needed to produce Figures 5-9)\n",
        "# ---------------------------------------------------------------------\n",
        "class SingleLayerPerceptron:\n",
        "    def __init__(self, n_features, learning_rate=0.01, n_epochs=50):\n",
        "        self.lr = learning_rate\n",
        "        self.n_epochs = n_epochs\n",
        "        self.weights = np.zeros(n_features)\n",
        "        self.bias = 0.0\n",
        "        self.history = {\"epoch\": [], \"errors\": [], \"weights\": [], \"bias\": []}\n",
        "\n",
        "    @staticmethod\n",
        "    def step_activation(z):\n",
        "        return np.where(z >= 0, 1, 0)\n",
        "\n",
        "    def predict(self, X):\n",
        "        z = np.dot(X, self.weights) + self.bias\n",
        "        return self.step_activation(z)\n",
        "\n",
        "    def fit(self, X, y, verbose=True):\n",
        "        for epoch in range(1, self.n_epochs + 1):\n",
        "            errors = 0\n",
        "            for xi, target in zip(X, y):\n",
        "                z = np.dot(xi, self.weights) + self.bias\n",
        "                y_hat = self.step_activation(z)\n",
        "                update = self.lr * (target - y_hat)\n",
        "                if update != 0.0:\n",
        "                    self.weights += update * xi\n",
        "                    self.bias += update\n",
        "                    errors += 1\n",
        "\n",
        "            self.history[\"epoch\"].append(epoch)\n",
        "            self.history[\"errors\"].append(errors)\n",
        "            self.history[\"weights\"].append(self.weights.copy())\n",
        "            self.history[\"bias\"].append(self.bias)\n",
        "\n",
        "            if verbose:\n",
        "                print(f\"Epoch {epoch:3d} | Misclassified: {errors:4d} | \"\n",
        "                      f\"Weights: {np.round(self.weights, 4)} | Bias: {self.bias:.4f}\")\n",
        "\n",
        "            if errors == 0:\n",
        "                print(f\"Converged at epoch {epoch}.\")\n",
        "                break\n",
        "        return self\n",
        "\n",
        "\n",
        "model = SingleLayerPerceptron(n_features=X_train.shape[1], learning_rate=0.01, n_epochs=50)\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "y_pred = model.predict(X_test)\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "prec = precision_score(y_test, y_pred)\n",
        "rec = recall_score(y_test, y_pred)\n",
        "f1 = f1_score(y_test, y_pred)\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "print(\"\\n--- Test Set Performance ---\")\n",
        "print(f\"Accuracy : {acc:.4f}\")\n",
        "print(f\"Precision: {prec:.4f}\")\n",
        "print(f\"Recall   : {rec:.4f}\")\n",
        "print(f\"F1-score : {f1:.4f}\")\n",
        "print(\"Confusion Matrix:\\n\", cm)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 5: Training Error vs Epoch\n",
