        "ax.set_xlabel(\"Epoch\")\n",
        "ax.set_ylabel(\"Misclassified Samples\")\n",
        "ax.set_title(\"Figure 5: Training Error vs Epoch\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/error_vs_epoch.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 6: Weight Evolution\n",
        "# ---------------------------------------------------------------------\n",
        "weights_arr = np.array(model.history[\"weights\"])\n",
        "fig, ax = plt.subplots(figsize=(4.5, 3))\n",
        "for i in range(weights_arr.shape[1]):\n",
        "    ax.plot(model.history[\"epoch\"], weights_arr[:, i], label=f\"w{i+1}\")\n",
        "ax.set_xlabel(\"Epoch\")\n",
        "ax.set_ylabel(\"Weight Value\")\n",
        "ax.set_title(\"Figure 6: Weight Evolution\")\n",
        "ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/weight_evolution.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 7: Bias Evolution\n",
        "# ---------------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(4.5, 3))\n",
        "ax.plot(model.history[\"epoch\"], model.history[\"bias\"], color=\"orange\", marker=\"o\")\n",
        "ax.set_xlabel(\"Epoch\")\n",
        "ax.set_ylabel(\"Bias Value\")\n",
        "ax.set_title(\"Figure 7: Bias Evolution\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{PLOTS_DIR}/bias_evolution.png\", **PNG_KWARGS)\n",
        "plt.close()\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Figure 8: Confusion Matrix\n",
        "# ---------------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(4, 4))\n",
        "ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"Authentic\", \"Forged\"]).plot(\n",
        "    cmap=\"Blues\", ax=ax\n",
        ")\n",
        "ax.set_title(\"Figure 8: Confusion Matrix\")\n",
