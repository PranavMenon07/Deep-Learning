        "Generates ONLY Figure 9: Learning Rate Comparison\n",
        "\"\"\"\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Setup\n",
        "# ---------------------------------------------------------------------\n",
        "RANDOM_STATE = 42\n",
        "np.random.seed(RANDOM_STATE)\n",
        "\n",
        "DPI = 150  # Overleaf-friendly size; change to 600 if you want print quality\n",
        "PNG_KWARGS = dict(dpi=DPI, bbox_inches=\"tight\", pil_kwargs={\"compress_level\": 9})\n",
        "\n",
        "PLOTS_DIR = \"plots\"\n",
        "os.makedirs(PLOTS_DIR, exist_ok=True)\n",
        "\n",
        "COLUMNS = [\"variance\", \"skewness\", \"curtosis\", \"entropy\", \"class\"]\n",
        "DATA_PATH = \"data_banknote_authentication.txt\"\n",
        "\n",
        "df = pd.read_csv(DATA_PATH, header=None, names=COLUMNS)\n",
        "\n",
        "X = df.drop(columns=[\"class\"]).values\n",
        "y = df[\"class\"].values\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_scaled, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# Perceptron implementation (needed to produce the plot)\n",
        "# ---------------------------------------------------------------------\n",
        "class SingleLayerPerceptron:\n",
        "    def __init__(self, n_features, learning_rate=0.01, n_epochs=50):\n",
        "        self.lr = learning_rate\n",
        "        self.n_epochs = n_epochs\n",
        "        self.weights = np.zeros(n_features)\n",
        "        self.bias = 0.0\n",
        "        self.history = {\"epoch\": [], \"errors\": []}\n",
        "\n",
        "    @staticmethod\n",
        "    def step_activation(z):\n",
        "        return np.where(z >= 0, 1, 0)\n",
        "\n",
        "    def predict(self, X):\n",
        "        z = np.dot(X, self.weights) + self.bias\n",
        "        return self.step_activation(z)\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        for epoch in range(1, self.n_epochs + 1):\n",
        "            errors = 0\n",
        "            for xi, target in zip(X, y):\n",
        "                z = np.dot(xi, self.weights) + self.bias\n",
        "                y_hat = self.step_activation(z)\n",
        "                update = self.lr * (target - y_hat)\n",
        "                if update != 0.0:\n",
        "                    self.weights += update * xi\n",
        "                    self.bias += update\n",
        "                    errors += 1\n",
        "            self.history[\"epoch\"].append(epoch)\n",
        "            self.history[\"errors\"].append(errors)\n",
        "            if errors == 0:\n",
        "                break\n",
        "        return self\n",
        "\n",
        "\n",
